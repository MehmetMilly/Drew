import { createServer } from 'vite';
import { chromium } from '@playwright/test';
const server = await createServer({ server: { port: 5195, host: '127.0.0.1' }, logLevel: 'error' });
await server.listen();
const browser = await chromium.launch();
const ctx = await browser.newContext({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 2 });
const page = await ctx.newPage(); const cdp0 = await ctx.newCDPSession(page); await cdp0.send('Emulation.setCPUThrottlingRate', { rate: 4 });
await page.goto('http://127.0.0.1:5195/');
await page.waitForFunction(() => (window as any).drew);
const r = await page.evaluate(`(async () => {
  const { toy, CANON } = window.drew;
  const names = ['stick1100', 'spider', 'giant', 'bruiser', 'reacher', 'hopper', 'stick700'];
  const xs = [100, 250, 400, 550, 640, 180, 470];
  let i = 0;
  while (toy.world.P.alive < 870 && i < 20) { toy.world.addStrokes(CANON[names[i % names.length]](xs[i % xs.length])); i++; }
  await new Promise(r => setTimeout(r, 500));
  const g = toy.g; const R = toy.renderer;
  const time = (f) => { const t0 = performance.now(); for (let k=0;k<30;k++) f(); g.getImageData(0,0,1,1); return ((performance.now()-t0)/30).toFixed(2); };
  const out = {};
  out.full = time(() => toy.render(0.5)); out.drawall = time(() => R.draw(g, {alpha:0.5, realT:0, debug:false}));
  out.ink = time(() => R.drawInk(g, 0.5, 0));
  out.terrain = time(() => R.drawTerrain(g, 0));
  out.shadows = time(() => { for (const c of toy.world.creatures) if (c.alive) R.drawShadow(g, c, 0.5); });
  out.faces = time(() => { for (const c of toy.world.creatures) if (c.alive) R.drawCreatureFace(g, c, {alpha:0.5, realT:0}, 0); });
  out.paper = time(() => g.drawImage(toy.paper, 0, 0, 720, 1280));
  out.desk = time(() => { g.save(); g.setTransform(1,0,0,1,0,0); g.drawImage(toy.desk, 0, 0); g.restore(); });
  out.overlay = time(() => toy.drawOverlay());
  out.step = time(() => toy.world.step());
  return out;
})()`);
console.log(r);
await browser.close(); await server.close();
