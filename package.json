{
  "name": "drew",
  "version": "1.0.0",
  "description": "Drew: everything you draw comes alive",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx tools/verify.ts",
    "metrics": "tsx tools/metrics.ts",
    "shots": "tsx tools/shots.ts",
    "shots:live": "tsx tools/liveshots.mts",
    "mix": "tsx tools/mixcheck.mts"
  },
  "keywords": [
    "game",
    "canvas",
    "physics",
    "verlet",
    "pwa",
    "typescript"
  ],
  "homepage": "https://drew-game.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MehmetMilly/Drew.git"
  },
  "author": "Mehmet Milly",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true
}
